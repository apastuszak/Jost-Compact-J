<?xml version="1.0" encoding="utf-8"?>

<designspace format="3">

  <axes>
      <axis minimum="100" maximum="900" default="400" name="Weight" tag="wght">
        <map input="100" output="10" />
        <map input="200" output="32" />
        <map input="300" output="55" />
        <map input="400" output="85" />
        <map input="500" output="120" />
        <map input="600" output="145" />
        <map input="700" output="172" />
        <map input="800" output="198" />
        <map input="900" output="225" />
      </axis>
      <axis minimum="0" maximum="2" default="0" name="Italic" tag="ital">
      </axis>
  </axes>

  <rules>
    <rule name="Suba">
      <conditionset>
        <condition maximum="225" minimum="10" name="Weight" />
        <condition maximum="2" minimum="0.5" name="Italic" />
      </conditionset>
      <sub name="a" with="a.alt" />
      <sub name="agrave" with="agrave.alt" />
      <sub name="aacute" with="aacute.alt" />
      <sub name="acircumflex" with="acircumflex.alt" />
      <sub name="atilde" with="atilde.alt" />
      <sub name="adieresis" with="adieresis.alt" />
      <sub name="aring" with="aring.alt" />
      <sub name="amacron" with="amacron.alt" />
      <sub name="abreve" with="abreve.alt" />
      <sub name="aogonek" with="aogonek.alt" />
    </rule>
  </rules>

  <sources>
    <source familyname="Jost Compact J" filename="../UFO/400.ufo" name="400" stylename="Book">
      <lib copy="1"/>
      <info copy="1"/>
      <kerning copy="1"/>
      <location>
        <dimension name="Weight" xvalue="85"/>
        <dimension name="Italic" xvalue="0"/>
      </location>
    </source>
